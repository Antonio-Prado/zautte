# Example /etc/pf.conf for the Zautte machine (FreeBSD).
# Replace the management networks and the proxy/load balancer address with the
# real ones (the addresses below are documentation ones, RFC 5737 and RFC 3849).
#
# Inbound everything is closed except:
#   SSH (22) and API (8000) from the management networks
#   API (8000) from the proxy/load balancer that publishes the service
#   ping and the ICMPv6 messages IPv6 needs (neighbor discovery)
# Outbound everything is open: crawler, model API, SMTP, DNS, NTP, pkg.
#
# Activation: sysrc pf_enable=YES pflog_enable=YES && service pf start && service pflog start
# Blocked packets: tcpdump -n -e -ttt -r /var/log/pflog
# Enabling pf remotely drops already open connections: see docs/operations.md.

ext_if = "vtnet0"
mgmt   = "{ 192.0.2.0/24, 198.51.100.0/24 }"
lb     = "2001:db8::81"

set skip on lo0
set block-policy drop

block log all

# LAN noise, dropped without logging: VRRP announcements (protocol 112)
# from the DNS servers and NetBIOS broadcasts from Windows PCs
block in quick on $ext_if inet proto 112 to 224.0.0.18
block in quick on $ext_if inet proto udp to port { 137, 138 }

pass out quick on $ext_if all keep state

pass in quick on $ext_if inet  proto icmp  icmp-type echoreq keep state
pass in quick on $ext_if inet6 proto icmp6 icmp6-type { echoreq, neighbrsol, neighbradv, routeradv, unreach, toobig, timex, paramprob }

pass in quick on $ext_if inet  proto tcp from $mgmt to ($ext_if) port { 22, 8000 }
pass in quick on $ext_if inet6 proto tcp from $lb   to ($ext_if) port 8000
