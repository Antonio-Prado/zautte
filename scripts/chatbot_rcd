#!/bin/sh
#
# PROVIDE: chatbot
# REQUIRE: NETWORKING ollama
# KEYWORD: shutdown

. /etc/rc.subr

name="chatbot"
rcvar="chatbot_enable"
desc="Zautte RAG chatbot"

chatbot_dir="/opt/chatbot"
# User the API runs as: set chatbot_user="zautte" (or another dedicated account) in
# /etc/rc.conf. With no user, or root, the service does not start (an old installation
# that really needs root says so with chatbot_allow_root="YES").
: ${chatbot_user:=}
: ${chatbot_allow_root:=NO}
chatbot_logfile="/var/log/chatbot.log"
pidfile="/var/run/${name}.pid"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

chatbot_start()
{
    if [ -z "${chatbot_user}" ] || [ "${chatbot_user}" = "root" ]; then
        if checkyesno chatbot_allow_root; then
            chatbot_user=root
        else
            echo "${name}: set chatbot_user to an unprivileged account in /etc/rc.conf" \
                 "(see docs/operations.md); chatbot_allow_root=\"YES\" keeps running it as root."
            return 1
        fi
    fi
    if [ -f "${pidfile}" ] && ps -p "$(cat "${pidfile}")" > /dev/null 2>&1; then
        echo "${name} is already running as pid $(cat "${pidfile}")."
        return 1
    fi

    echo "Starting ${name}."

    rm -f /var/run/chatbot.maintenance

    # .env is loaded by python-dotenv (config/settings.py): exporting it from here with
    # xargs split values containing spaces (SITE_NAME=Comune di … became «Comune»).

    cd "${chatbot_dir}" || return 1

    # -H: on newsyslog SIGHUP (rotation) daemon reopens the log file,
    # otherwise it would keep writing to the one just archived.
    # -u: the supervisor stays root (it owns the pid file and the log); the API
    # process runs as ${chatbot_user}.
    _user_opt=""
    [ "${chatbot_user}" != "root" ] && _user_opt="-u ${chatbot_user}"
    /usr/sbin/daemon \
        ${_user_opt} \
        -P "${pidfile}" \
        -H \
        -o "${chatbot_logfile}" \
        "${chatbot_dir}/start.sh"
}

chatbot_stop()
{
    echo "Stopping ${name}."

    touch /var/run/chatbot.maintenance

    if [ ! -f "${pidfile}" ]; then
        echo "${name} pidfile not found, trying pkill..."
        pkill -TERM -f "api.main:app" 2>/dev/null
        sleep 2
        pkill -KILL -f "api.main:app" 2>/dev/null
        return 0
    fi

    _pid=$(cat "${pidfile}")

    kill -TERM "${_pid}" 2>/dev/null

    _i=0
    while kill -0 "${_pid}" 2>/dev/null; do
        _i=$(( _i + 1 ))
        if [ "${_i}" -ge 10 ]; then
            echo "Supervisor still alive, forcing stop."
            kill -KILL "${_pid}" 2>/dev/null
            break
        fi
        sleep 1
    done

    pkill -TERM -f "api.main:app" 2>/dev/null
    sleep 1
    pkill -KILL -f "api.main:app" 2>/dev/null

    rm -f "${pidfile}"
    echo "${name} stopped."
}

chatbot_status()
{
    if [ -f "${pidfile}" ] && ps -p "$(cat "${pidfile}")" > /dev/null 2>&1; then
        echo "${name} is running as pid $(cat "${pidfile}")."
    else
        echo "${name} is not running."
    fi
}

load_rc_config $name
: ${chatbot_enable:=NO}

run_rc_command "$1"
