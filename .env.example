# ============================================================
# Zautte — file di configurazione ambiente
# Copia questo file in .env e compila i valori
# ============================================================

# --- Sito da indicizzare (OBBLIGATORI) ---
SITE_URL=https://www.tuo-sito.it
SITE_NAME=Nome del tuo ente o organizzazione

# Domini consentiti nel crawl (separati da virgola)
# Includi il dominio principale e tutti i sottodomini da indicizzare
CRAWL_ALLOWED_DOMAINS=www.tuo-sito.it

# --- LLM provider: "ollama" (locale), "claude" (API Anthropic) oppure "bedrock" (Claude su AWS) ---
LLM_PROVIDER=ollama

# Ollama (locale, privacy totale)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Claude API (Anthropic) — usare se LLM_PROVIDER=claude
# Richiede account Anthropic e, per enti pubblici, verifica dei requisiti normativi
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Sforzo di ragionamento dei modelli Sonnet 5.x: low | medium | high
LLM_EFFORT=low

# Claude su AWS Bedrock — usare se LLM_PROVIDER=bedrock (pip install "anthropic[bedrock]").
# Il profilo "eu." elabora le richieste solo in regioni AWS dell'UE. Credenziali AWS
# dalla catena standard (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE...).
BEDROCK_AWS_REGION=eu-south-1
BEDROCK_MODEL=eu.anthropic.claude-sonnet-5-5

# --- Dati personali nelle domande ---
# Codice fiscale, IBAN, carte, email e telefoni mascherati prima del modello e dei log.
# Le email dei domini istituzionali indicati restano in chiaro.
PII_REDACTION=true
PII_KEEP_EMAIL_DOMAINS=tuo-sito.it

# --- Conservazione dei log (giorni, 0 = nessuna scadenza) — vedi scripts/purge_logs.py ---
RETENTION_USAGE_TEXT_DAYS=90
RETENTION_USAGE_DAYS=365
RETENTION_GAPS_DAYS=180
RETENTION_FEEDBACK_DAYS=365

# --- Backend API ---
API_HOST=127.0.0.1
API_PORT=8000
# Dominio/i del sito su cui viene embeddato il widget (per CORS)
API_CORS_ORIGINS=https://www.tuo-sito.it

# --- Autenticazione endpoint admin (/stats, /gaps, /feedback/list, /usage/summary) ---
# Lasciare vuoto per disabilitare l'autenticazione (SOLO in sviluppo)
ADMIN_API_KEY=cambia-questa-chiave-in-produzione

# --- Autenticazione utenti (login email+password, progetto pilota) ---
# AUTH_ENABLED=true → il bot risponde solo a utenti autenticati (/chat, /feedback).
#   Serve per capire chi lo usa, quando e quanto (data/usage.jsonl, /usage/summary).
# AUTH_SECRET → segreto per firmare i token di sessione (OBBLIGATORIO se attivo).
#   Genera con:  python -c "import secrets; print(secrets.token_hex(32))"
# Crea gli utenti con:  python -m scripts.adduser --email ... --name "..."
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_TOKEN_TTL_DAYS=30

# --- Invio email (SMTP) — per recapitare le credenziali ai partecipanti ---
# Relay interno (destinatari @comunesbt.it): host mail.comunesbt.it, porta 25, no auth/TLS.
# SMTP_USER/PASSWORD/STARTTLS solo se il relay li richiede.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=noreply@comunesbt.it
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# URL della pagina di login mostrato nell'email ai partecipanti
PILOT_LOGIN_URL=
