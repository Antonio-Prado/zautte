# ============================================================
# Zautte — environment configuration file
# Copy this file to .env and fill in the values
# ============================================================

# --- Site to index (REQUIRED) ---
SITE_URL=https://www.tuo-sito.it
SITE_NAME=Nome del tuo ente o organizzazione

# Folder outside the repository with the organization's customizations (widget pages
# and logos, restricted area, config); see docs/configuration.md. Empty = generic files.
INSTANCE_DIR=

# Domains whose content is no longer reachable (portal replaced): their links
# are not shown. Comma-separated list; empty = none.
MIGRATED_DOMAINS=

# Domains allowed in the crawl (comma-separated)
# Include the main domain and all subdomains to index
CRAWL_ALLOWED_DOMAINS=www.tuo-sito.it

# --- LLM provider: "ollama" (local), "claude" (Anthropic API) or "bedrock" (Claude on AWS) ---
LLM_PROVIDER=ollama

# Ollama (local, full privacy)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=bge-m3

# Claude API (Anthropic) — use if LLM_PROVIDER=claude
# Requires an Anthropic account and, for public bodies, verification of regulatory requirements
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Reasoning effort, only for Sonnet 5.x models: low | medium | high
LLM_EFFORT=low

# Claude on AWS Bedrock — use if LLM_PROVIDER=bedrock (pip install "anthropic[bedrock]").
# The "eu." profile processes requests only in EU AWS regions. AWS credentials
# from the standard chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE...).
BEDROCK_AWS_REGION=eu-south-1
BEDROCK_MODEL=eu.anthropic.claude-sonnet-4-6

# --- Personal data in questions ---
# Tax codes, IBANs, cards, emails and phone numbers masked before the model and the logs.
# Emails from the listed institutional domains stay in clear.
PII_REDACTION=true
PII_KEEP_EMAIL_DOMAINS=tuo-sito.it

# --- Log retention (days, 0 = no expiry) — see scripts/purge_logs.py ---
RETENTION_USAGE_TEXT_DAYS=90
RETENTION_USAGE_DAYS=365
RETENTION_GAPS_DAYS=180
RETENTION_FEEDBACK_DAYS=365

# --- Backend API ---
API_HOST=127.0.0.1
API_PORT=8000
# Domain(s) of the site on which the widget is embedded (for CORS)
API_CORS_ORIGINS=https://www.tuo-sito.it
# Proxy/load balancer in front of the API (comma-separated addresses or networks): from
# these X-Forwarded-For is accepted, so per-IP limits and logs see the real
# client. Never "*". Default: 127.0.0.1,::1
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Interactive API documentation (/docs, /openapi.json): development only
API_DOCS=false

# --- Admin endpoint authentication (/stats, /gaps, /feedback/list, /usage/summary) ---
# With an empty key all admin requests are refused; set ADMIN_AUTH_DISABLED=true
# to open them instead (development ONLY)
ADMIN_API_KEY=cambia-questa-chiave-in-produzione
ADMIN_AUTH_DISABLED=false
# Address of the restricted area (e.g. /nome); empty = disabled
ADMIN_PATH=

# --- User authentication (email+password login, pilot project) ---
# AUTH_ENABLED=true → the bot answers only authenticated users (/chat, /feedback).
#   It serves to understand who uses it, when and how much (data/usage.jsonl, /usage/summary).
# AUTH_SECRET → secret used to sign session tokens (REQUIRED if enabled).
#   Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Create users with:  python -m scripts.adduser --email ... --name "..."
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_TOKEN_TTL_DAYS=30
# Questions per day per user on /chat and /chat/stream (0 = no limit;
# with AUTH_ENABLED=false the count is per IP). Restarts from zero at midnight.
DAILY_QUESTION_LIMIT=20

# --- Email sending (SMTP) — to deliver credentials to participants ---
# Internal relay (recipients in the organization's domain): host mail.example.it, port 25, no auth/TLS.
# SMTP_USER/PASSWORD/STARTTLS/SSL only if the relay requires them
# (STARTTLS=true for port 587, SSL=true for port 465).
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=noreply@example.it
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
# Login page URL shown in the email to participants
PILOT_LOGIN_URL=
# Public address of the site, used for the links in emails (password reset).
# Empty = the origin of PILOT_LOGIN_URL; if both are empty no reset link is sent.
PUBLIC_BASE_URL=
