# ============================================================
# Zautte — environment configuration file
# Copy this file to .env and fill in the values
# ============================================================

# --- Site to index (REQUIRED) ---
SITE_URL=https://www.your-site.com
SITE_NAME=Your organization

# Folder outside the repository with the organization's customizations (widget pages
# and logos, restricted area, config); see docs/configuration.md. Empty = generic files.
INSTANCE_DIR=

# Domains whose content is no longer reachable (portal replaced): their links
# are not shown. Comma-separated list; empty = none.
MIGRATED_DOMAINS=

# Domains allowed in the crawl (comma-separated)
# Include the main domain and all subdomains to index
CRAWL_ALLOWED_DOMAINS=www.your-site.com
# A host is allowed if it is one of these domains or a subdomain of one. The crawler and the news
# sync never fetch other hosts, IP addresses, or hosts resolving to a private address, and check
# every redirect.
CRAWL_BLOCK_PRIVATE_IPS=true
# Hosts of yours that resolve to a private address on this server (split-horizon DNS)
CRAWL_PRIVATE_OK_HOSTS=
# Size limits of one download, in MB: pages and feeds / PDFs and other attachments
CRAWL_MAX_PAGE_MB=20
CRAWL_MAX_FILE_MB=100
# Longest time of one download (seconds), and distinct query-string variants of one path the crawler follows
#CRAWL_MAX_DOWNLOAD_SECONDS=300
#CRAWL_MAX_QUERY_VARIANTS=25
# PDF extraction: pages read, characters kept, seconds on one file (what was read so far is kept)
#PDF_MAX_PAGES=2000
#PDF_MAX_CHARS=5000000
#PDF_MAX_SECONDS=180

# --- LLM provider: "ollama" (local), "claude" (Anthropic API) or "bedrock" (Claude on AWS) ---
LLM_PROVIDER=ollama

# Ollama (local, full privacy)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=bge-m3

# Claude API (Anthropic) — use if LLM_PROVIDER=claude
# Requires an Anthropic account and, for public bodies, verification of regulatory requirements
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Reasoning effort (low | medium | high) for adaptive-reasoning models (Sonnet 5.x, Opus 4.7 and later);
# ignored by claude-sonnet-4-6
LLM_EFFORT=low
# Model that rewrites follow-up questions (default: the answer model); a cheaper one can be used
#CLAUDE_REWRITE_MODEL=
#BEDROCK_REWRITE_MODEL=
QUERY_REWRITE=true

# Claude on AWS Bedrock — use if LLM_PROVIDER=bedrock (pip install "anthropic[bedrock]").
# The "eu." profile processes requests only in EU AWS regions. AWS credentials
# from the standard chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE...).
BEDROCK_AWS_REGION=eu-south-1
BEDROCK_MODEL=eu.anthropic.claude-sonnet-4-6

# --- Personal data in questions ---
# Tax codes, IBANs, cards, emails and phone numbers masked before the model and the logs.
# Emails from the listed institutional domains stay in clear.
PII_REDACTION=true
PII_KEEP_EMAIL_DOMAINS=your-site.com
# Refuse a question that contains personal data: no search, no model call, nothing logged
PII_BLOCK=true

# --- Log retention (days, 0 = no expiry) — see scripts/purge_logs.py (RETENTION_STATS_DAYS is applied by the API itself) ---
RETENTION_USAGE_TEXT_DAYS=90
RETENTION_USAGE_DAYS=365
RETENTION_GAPS_DAYS=180
RETENTION_FEEDBACK_DAYS=365
RETENTION_STATS_DAYS=90

# --- Backend API ---
# Addresses to listen on, comma-separated. Local only by default; behind a proxy on another
# host use 0.0.0.0,:: and let the firewall (PF) allow only the proxy and the admin networks.
API_HOST=127.0.0.1,::1
API_PORT=8000
# Domain(s) of the site on which the widget is embedded (for CORS)
API_CORS_ORIGINS=https://www.your-site.com
# Proxy/load balancer in front of the API (comma-separated addresses or networks): from
# these X-Forwarded-For is accepted, so per-IP limits and logs see the real
# client. Never "*". Default: 127.0.0.1,::1
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Interactive API documentation (/docs, /openapi.json): development only
API_DOCS=false

# --- Admin endpoint authentication (/stats, /gaps, /feedback/{list,negative,resolve},
#     /usage/{summary,messages}, /crawl-history and the detailed /health) ---
# With an empty key all admin requests are refused; set ADMIN_AUTH_DISABLED=true
# to open them instead (development ONLY). A key shorter than 16 characters, or one that starts
# with "cambia", stops the API from starting. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
ADMIN_AUTH_DISABLED=false
# Wrong admin keys allowed per address, and the lockout (429) once reached, in seconds
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=900
# Address of the restricted area (e.g. /nome); empty = disabled
ADMIN_PATH=

# --- User authentication (email+password login, pilot project) ---
# AUTH_ENABLED=true → the bot answers only authenticated users (/chat, /chat/stream, /feedback).
#   It serves to understand who uses it, when and how much (data/usage.jsonl, /usage/summary).
# AUTH_SECRET → secret used to sign session tokens (at least 16 characters, REQUIRED if enabled).
#   Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Create users with:  python -m scripts.adduser --email ... --name "..."
# The API refuses to start when users.json has accounts but AUTH_ENABLED is not true (a lost .env would
# otherwise open the bot to everybody); ALLOW_ANONYMOUS=true says that an open bot is intended.
AUTH_ENABLED=false
#ALLOW_ANONYMOUS=false
AUTH_SECRET=
AUTH_TOKEN_TTL_DAYS=7
# Questions per day per user on /chat and /chat/stream (0 = no limit;
# with AUTH_ENABLED=false the count is per IP). Restarts from zero at midnight.
DAILY_QUESTION_LIMIT=20
# Wrong passwords before an account refuses logins, and the window/duration (seconds); reset emails per account per hour
#LOGIN_MAX_FAILURES=10
#LOGIN_LOCK_SECONDS=900
#RESET_EMAILS_PER_HOUR=3
# Content-Security-Policy of the pages: enforce (default) | report-only (the browser logs violations and blocks nothing:
# to try a change) | off. Hosts added for scripts, connections and images (the Matomo server), who may frame the pages.
#CSP_MODE=enforce
#CSP_EXTRA_HOSTS=https://matomo.example.org
#FRAME_ANCESTORS='none'
# Largest request body in bytes (413 above it)
#MAX_BODY_BYTES=131072
# Answers being generated at once: for each user, and in the whole process (over the limit: HTTP 429 "busy")
LLM_MAX_PER_USER=2
LLM_MAX_CONCURRENT=8

# --- Email sending (SMTP) — to deliver credentials to participants ---
# Internal relay (recipients in the organization's domain): host mail.example.it, port 25, no auth/TLS.
# SMTP_USER/PASSWORD/STARTTLS/SSL only if the relay requires them
# (STARTTLS=true for port 587, SSL=true for port 465).
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
# Login page URL shown in the email to participants
PILOT_LOGIN_URL=
# Public address of the site, used for the links in emails (password reset).
# Empty = the origin of PILOT_LOGIN_URL; if both are empty no reset link is sent.
PUBLIC_BASE_URL=

# --- Maintenance and sync accounts ---
# Account that purge_logs and adduser become when started as root (empty = owner of the existing data files)
SERVICE_USER=
# Where sync jobs that are not root leave restart/reload requests for the watchdog
#SYNC_CONTROL_DIR=/var/db/zautte-sync
# Address that receives the email notifications of feedback reports and long sync runs
FEEDBACK_NOTIFY_EMAIL=
